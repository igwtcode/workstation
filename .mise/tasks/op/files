#!/usr/bin/env bash
#MISE description="Restore or back up machine-local paths (aws, shell history, tool configs) as 1Password documents"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=(--execute)
while (($#)); do
  case $1 in
    -y | --yes)
      args+=(--non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" vault files "${args[@]}"

#!/usr/bin/env bash
#MISE description="Restore or back up the .env files of a code tree via a 1Password document (zip)"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=(--execute)
while (($#)); do
  case $1 in
    -y | --yes)
      args+=(--non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" vault envfiles "${args[@]}"

#!/usr/bin/env bash
#MISE description="Apply the symlink manifest and theme templates (repo -> HOME) for this machine's profile"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=()
while (($#)); do
  case $1 in
    -p | --profile)
      [[ $# -ge 2 ]] || {
        printf 'error: %s needs a value\n' "$1" >&2
        exit 2
      }
      case $2 in
        mac) args+=(--preset mac-workstation) ;;
        arch) args+=(--preset arch-desktop) ;;
        server) args+=(--preset server) ;;
        *) args+=(--preset "$2") ;;
      esac
      shift 2
      ;;
    -p=* | --profile=*)
      val=${1#*=}
      case $val in
        mac) args+=(--preset mac-workstation) ;;
        arch) args+=(--preset arch-desktop) ;;
        server) args+=(--preset server) ;;
        *) args+=(--preset "$val") ;;
      esac
      shift
      ;;
    -y | --yes)
      args+=(--allow all --non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" apply ${args[@]+"${args[@]}"}

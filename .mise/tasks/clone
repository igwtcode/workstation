#!/usr/bin/env bash
#MISE description="Bulk-clone repos from a configured forge (github, codecommit) into a zone tree"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=()
while (($#)); do
  case $1 in
    -z)
      args+=(--zone)
      shift
      ;;
    -z=*)
      args+=("--zone=${1#-z=}")
      shift
      ;;
    -y | --yes)
      args+=(--non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" repo clone ${args[@]+"${args[@]}"}

#!/usr/bin/env bash
#MISE description="Fetch + fast-forward every git clone under the code root, with a summary"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

exec "$ws" repo pull "$@"

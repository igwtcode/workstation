#!/usr/bin/env bash
#MISE description="Back up the private local layer (mise.local.toml + local:* tasks) to 1Password"
#USAGE flag "-y --yes" help="Skip confirmation"
set -euo pipefail

root=${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}
# shellcheck source=lib/common.sh
source "$root/lib/common.sh"
# shellcheck source=lib/op.sh
source "$root/lib/op.sh"

[[ ${usage_yes:-false} == true ]] && export WS_YES=1

doc_title=${WS_OP_SECRETS_DOC:-workstation-secrets.zip}

paths=()
[[ -f $root/mise.local.toml ]] && paths+=(mise.local.toml)
[[ -d $root/.mise/tasks/local ]] && paths+=(.mise/tasks/local)
[[ ${#paths[@]} -gt 0 ]] ||
  die "nothing to back up — neither mise.local.toml nor .mise/tasks/local/ exists in $root"

log "bundle: ${paths[*]}"
require_cmd zip
confirm "Back up the private local layer to 1Password document '$doc_title'?"
op_ensure

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
(cd "$root" && zip -qr "$tmp/secrets.zip" "${paths[@]}")
op_doc_put "$doc_title" "$tmp/secrets.zip"
log "backed up ${paths[*]} → 1Password document '$doc_title'"

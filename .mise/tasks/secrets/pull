#!/usr/bin/env bash
#MISE description="Restore the private local layer (mise.local.toml + local:* tasks) from 1Password"
#USAGE flag "-y --yes" help="Skip confirmation"
set -euo pipefail

root=${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}
# shellcheck source=lib/common.sh
source "$root/lib/common.sh"
# shellcheck source=lib/op.sh
source "$root/lib/op.sh"

[[ ${usage_yes:-false} == true ]] && export WS_YES=1

doc_title=${WS_OP_SECRETS_DOC:-workstation-secrets.zip}

existing=()
[[ -f $root/mise.local.toml ]] && existing+=(mise.local.toml)
[[ -d $root/.mise/tasks/local ]] && existing+=(.mise/tasks/local)
if [[ ${#existing[@]} -gt 0 ]]; then
  confirm "Overwrite existing ${existing[*]} with the 1Password bundle '$doc_title'?"
else
  confirm "Restore the private local layer from 1Password document '$doc_title'?"
fi
require_cmd unzip
op_ensure

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
op_doc_get "$doc_title" "$tmp/secrets.zip"
unzip -qo "$tmp/secrets.zip" -d "$root"
# mise only runs a file task that is executable; don't rely on the archive
[[ -d $root/.mise/tasks/local ]] && find "$root/.mise/tasks/local" -type f -exec chmod +x {} +
[[ -f $root/mise.local.toml ]] && chmod 600 "$root/mise.local.toml"
log "private layer restored from '$doc_title' — 'mise tasks' now lists local:* tasks"
log "if mise prompts about untrusted config, run: mise trust"

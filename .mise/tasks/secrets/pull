#!/usr/bin/env bash
#MISE description="Restore the private local layer (mise.local.toml + local:* tasks) from 1Password"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=(--execute)
while (($#)); do
  case $1 in
    -y | --yes)
      args+=(--non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" vault secrets pull "${args[@]}"

#!/usr/bin/env bash
#MISE description="Install Android SDK packages from pkg/android.txt and create the AVDs listed in WS_ANDROID_AVDS"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=()
while (($#)); do
  case $1 in
    -y | --yes)
      args+=(--yes)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" android ${args[@]+"${args[@]}"}

#!/usr/bin/env bash
#MISE description="Bootstrap this machine (machine-mutating): packages, OS setup, symlinks, identity, theme"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=()
while (($#)); do
  case $1 in
    -p)
      args+=(--profile)
      shift
      ;;
    -p=*)
      args+=("--profile=${1#-p=}")
      shift
      ;;
    -y)
      args+=(--yes)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" bootstrap ${args[@]+"${args[@]}"}

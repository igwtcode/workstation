#!/usr/bin/env bash
#MISE description="Switch terminal theme: render color templates, run post-hooks, record the choice"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=()
while (($#)); do
  case $1 in
    -l)
      args+=(--list)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" theme ${args[@]+"${args[@]}"}

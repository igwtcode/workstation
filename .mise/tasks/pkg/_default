#!/usr/bin/env bash
#MISE description="Update the OS package manager only: refresh, upgrade, clean up (brew on mac, paru+paccache on arch)"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

args=(--pkg-only)
while (($#)); do
  case $1 in
    -a)
      args+=(--all)
      shift
      ;;
    -c | --check)
      args+=(--digest)
      shift
      ;;
    -y | --yes)
      args+=(--allow all --non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" update "${args[@]}"

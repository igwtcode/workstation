#!/usr/bin/env bash
#MISE description="Scaffold/refresh the identity zones (~/work, ~/personal): dirs, mise trust, per-zone git identity"
set -euo pipefail

ws=$(command -v ws || true)
[[ -n $ws || ! -x $HOME/.local/bin/ws ]] || ws=$HOME/.local/bin/ws
[[ -n $ws ]] || {
  printf 'error: ws not installed — run: mise run ws:install\n' >&2
  exit 1
}

sub=apply
args=()
while (($#)); do
  case $1 in
    -s | --status)
      sub=status
      shift
      ;;
    -y | --yes)
      args+=(--non-interactive)
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
exec "$ws" zone "$sub" ${args[@]+"${args[@]}"}

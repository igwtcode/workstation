#!/usr/bin/env bash
#MISE description="Scaffold/refresh the identity zones (~/work, ~/personal): dirs, mise trust, per-zone git identity"
#USAGE arg "[zone]" help="Only this zone (default: every zone in WS_ZONES)"
#USAGE flag "-s --status" help="Report every zone's resolved identity and exit (touches nothing)"
#USAGE flag "-n --dry-run" help="Report what would change without touching anything"
#USAGE flag "-y --yes" help="Skip confirmations"
set -euo pipefail

root=${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}
# shellcheck source=lib/common.sh
source "$root/lib/common.sh"
# shellcheck source=lib/zone.sh
source "$root/lib/zone.sh"

[[ ${usage_yes:-false} == true ]] && export WS_YES=1
[[ ${usage_dry_run:-false} == true ]] && export WS_DRY_RUN=1
tag=""
[[ ${WS_DRY_RUN:-0} == 1 ]] && tag="[dry-run] "

require_cmd mise jq git

# The env vars every zone config defines; read from mise, never hardcoded.
zone_vars=(WS_CODE_ROOT GH_CONFIG_DIR CLAUDE_CONFIG_DIR AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE AWS_PROFILE KUBECONFIG)

# mark <state> <text> — one status line, colored by state
mark() {
  local state=$1 color=8
  shift
  case $state in
    created | ok) color=2 ;;
    changed | trusted) color=3 ;;
    missing) color=1 ;;
  esac
  styled "$color" "$(printf '%-9s %s' "$state" "$*")"
}

# --- status ------------------------------------------------------------------

status_zone() {
  local name=$1 root cfg var val
  root=$(zone_root "$name")
  cfg=$(zone_config "$name")

  # field <label> <value> — one aligned status line
  field() { printf '  %-27s %s\n' "$1" "$2"; }

  styled 4 "zone $name"
  field root "$(zone_tilde "$root")$([[ -d $root ]] || echo '  (missing)')"
  if [[ -e $cfg ]]; then
    field config \
      "$(zone_tilde "$cfg")  ($(zone_trusted "$root" && echo trusted || echo 'UNTRUSTED — run: mise run identity'))"
  else
    field config "missing — run: mise run identity"
  fi

  local gitcfg
  gitcfg=$(zone_gitconfig "$name")
  if [[ -f $gitcfg ]]; then
    field git "$(git config --file "$gitcfg" --get user.name || echo '?') <$(git config --file "$gitcfg" --get user.email || echo '?')>"
  else
    field git "no $(zone_tilde "$gitcfg") — run: mise run identity"
  fi

  for var in "${zone_vars[@]}"; do
    val=$(zone_env "$name" "$var")
    [[ -n $val ]] || continue
    case $var in
      *_DIR | *_ROOT | *_FILE)
        field "$var" "$(zone_tilde "$val")$([[ -e $val ]] || echo '  (missing)')"
        ;;
      *) field "$var" "$val" ;;
    esac
  done
}

if [[ ${usage_status:-false} == true ]]; then
  current=$(zone_current || true)
  styled 4 "current zone: ${current:-none (outside every zone)}"
  while IFS= read -r name; do status_zone "$name"; done < <(zone_names)
  exit 0
fi

# --- scaffolding -------------------------------------------------------------

# write_file <path> <mode> <content> — create/update, reporting what changed
write_file() {
  local path=$1 mode=$2 content=$3 disp
  disp=$(zone_tilde "$path")
  if [[ -f $path ]] && [[ $(cat "$path") == "$content" ]]; then
    mark ok "$disp"
    return 0
  fi
  local state=created
  [[ -e $path ]] && state=changed
  if [[ ${WS_DRY_RUN:-0} != 1 ]]; then
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$content" >"$path"
    chmod "$mode" "$path"
  fi
  mark "$state" "$tag$disp"
}

# zone_git_identity <name> <git-name> <git-email> [signingkey] — the
# generated per-zone gitconfig, included by ~/.config/git/config
zone_git_identity() {
  local name=$1 gname=$2 gemail=$3 signkey=${4:-} out
  printf -v out '%s\n' \
    "# git identity for the $name zone — generated by \`mise run identity\`" \
    "# from WS_ZONES (mise.local.toml). Included by ~/.config/git/config for" \
    "# every repo under ~/$name/. Edit WS_ZONES, not this file." \
    "" \
    "[user]" \
    "	name = $gname" \
    "	email = $gemail"
  if [[ -n $signkey ]]; then
    out+="	signingkey = $signkey"$'\n'
    # an ssh key (path or literal) needs git's ssh signing format
    if [[ $signkey == ssh-* || $signkey == */* ]]; then
      out+=$'\n''[gpg]'$'\n''	format = ssh'$'\n'
    fi
    out+=$'\n''[commit]'$'\n''	gpgsign = true'$'\n'
    out+=$'\n''[tag]'$'\n''	gpgsign = true'$'\n'
  fi
  printf '%s' "$out"
}

apply_zone() {
  local line=$1 name gname gemail signkey awsprofile
  IFS='|' read -r name gname gemail signkey awsprofile <<<"$line"
  local zroot cfg
  zroot=$(zone_root "$name")
  cfg=$(zone_config "$name")

  styled 4 "zone $name"

  # tree roots — code/ is the conventional home of the zone's repos
  local dir
  for dir in "$zroot" "$zroot/code"; do
    if [[ -d $dir ]]; then
      mark ok "$(zone_tilde "$dir")/"
    else
      zone_run mkdir -p "$dir"
      mark created "$tag$(zone_tilde "$dir")/"
    fi
  done

  # The zone's mise config is a real file, not a manifest symlink: it is the
  # natural home for machine-local secret env vars, which must never be able
  # to reach the repo. config/identity/<zone>.mise.toml is the seed — copied
  # once, then owned by the machine. Re-runs never overwrite it; they only
  # report when the repo seed has moved on, so an improvement upstream is
  # visible without silently clobbering local additions.
  local seed=$root/config/identity/$name.mise.toml
  # -L before -e: a *broken* symlink is not -e, and copying onto it would
  # write through the link — straight into the repo for a leftover manifest
  # link. Any symlink here is reported, never written to.
  if [[ -L $cfg ]]; then
    warn "$name: $(zone_tilde "$cfg") is a symlink — the zone config must be a real file; replace it with: cp --remove-destination '$seed' '$cfg' && chmod 600 '$cfg'"
  elif [[ ! -e $cfg ]]; then
    if [[ ! -f $seed ]]; then
      mark missing "$(zone_tilde "$cfg") — no seed at config/identity/$name.mise.toml"
      return 0
    fi
    if [[ ${WS_DRY_RUN:-0} != 1 ]]; then
      mkdir -p "$zroot"
      cp "$seed" "$cfg"
      chmod 600 "$cfg"
    fi
    mark created "$tag$(zone_tilde "$cfg")  (yours now — add secret env vars here)"
  elif [[ -f $seed ]] && ! cmp -s "$seed" "$cfg"; then
    mark ok "$(zone_tilde "$cfg")  (local edits; repo seed differs — diff against $seed)"
  else
    mark ok "$(zone_tilde "$cfg")"
  fi

  # Trust before anything reads the zone env below: `[env]` templating makes
  # a fresh config untrusted, and an untrusted config in the chain makes
  # every later mise call *error*, not warn — including the ones this task
  # and `mise run theme` make from inside a zone. Trust is granted per config
  # *directory* (verified on mise 2026.7), so one call covers mise.toml and
  # the private mise.local.toml next to it, and it survives later edits.
  if [[ ${WS_DRY_RUN:-0} == 1 ]]; then
    styled 8 "$(printf '%-9s %s' note "would trust $(zone_tilde "$zroot")")"
  elif zone_trusted "$zroot"; then
    mark ok "trust $(zone_tilde "$zroot")"
  else
    mise trust "$cfg" >/dev/null
    mark trusted "$(zone_tilde "$zroot")"
  fi

  # private per-zone env (AWS_PROFILE): gitignored, written from WS_ZONES.
  # Only ever touch a file this task generated — never clobber hand-written
  # private extras.
  local localcfg="$zroot/mise.local.toml" header="# generated by \`mise run identity\` from WS_ZONES — never commit this file"
  if [[ -n ${awsprofile:-} ]]; then
    if [[ -f $localcfg ]] && ! head -1 "$localcfg" | grep -qF "generated by"; then
      warn "$name: $(zone_tilde "$localcfg") is hand-written — set AWS_PROFILE there yourself"
    else
      write_file "$localcfg" 600 "$header
# It is a normal mise config: add private per-zone env vars below.

[env]
AWS_PROFILE = \"$awsprofile\""
    fi
  fi

  write_file "$(zone_gitconfig "$name")" 644 \
    "$(zone_git_identity "$name" "$gname" "$gemail" "${signkey:-}")"

  # per-zone tool locations, straight from the zone's own mise config
  local var val
  if [[ -z $(zone_env "$name" GH_CONFIG_DIR) ]]; then
    if [[ ${WS_DRY_RUN:-0} == 1 ]]; then
      styled 8 "$(printf '%-9s %s' note "gh/claude/aws paths follow once the config is trusted")"
    else
      warn "$name: zone env unreadable — inspect with 'mise env -C $(zone_tilde "$zroot")'"
    fi
    return 0
  fi
  for var in GH_CONFIG_DIR CLAUDE_CONFIG_DIR; do
    val=$(zone_env "$name" "$var")
    [[ -n $val ]] || continue
    if [[ -d $val ]]; then
      mark ok "$(zone_tilde "$val")/"
    else
      zone_run mkdir -p "$val"
      mark created "$tag$(zone_tilde "$val")/"
    fi
  done
  # Credential/context files the zone points at: create them empty so the
  # tools see a valid (if unpopulated) path instead of erroring on a missing
  # one. Filling them is deliberately manual — credentials get sorted per
  # identity by hand, or restored with `mise run op:files load`.
  local hint
  for var in AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE KUBECONFIG; do
    val=$(zone_env "$name" "$var")
    [[ -n $val ]] || continue
    if [[ -f $val ]]; then
      mark ok "$(zone_tilde "$val")"
    else
      hint="(empty — fill it in, or 'mise run op:files load')"
      zone_run mkdir -p "$(dirname "$val")"
      zone_run touch "$val"
      zone_run chmod 600 "$val"
      mark created "$tag$(zone_tilde "$val")  $hint"
    fi
  done
}

# --- main --------------------------------------------------------------------

want=${usage_zone:-}
if [[ -n $want ]]; then
  lines=("$(zone_line "$want")")
else
  mapfile -t lines < <(zone_lines)
fi

log "identity: ${#lines[@]} zone(s)${WS_DRY_RUN:+ (dry-run)}"
for line in "${lines[@]}"; do apply_zone "$line"; done

styled 2 "identity: done — 'mise run identity --status' to inspect"

# linux layer, applied after common. Format: see common.links.

# terminal emulators
config/alacritty/linux.toml ~/.config/alacritty/alacritty.toml
config/alacritty/shared.toml ~/.config/alacritty/shared.toml
config/alacritty/themes ~/.config/alacritty/themes
config/ghostty/config ~/.config/ghostty/config
config/ghostty/linux.conf ~/.config/ghostty/os.conf
config/ghostty/themes ~/.config/ghostty/themes
config/kitty ~/.config/kitty

# desktop
config/niri ~/.config/niri
config/hypr ~/.config/hypr
config/noctalia ~/.config/noctalia

# GUI apps
config/zed ~/.config/zed
config/btop ~/.config/btop
config/vscode/settings.json ~/.config/Code/User/settings.json
config/vscode/keybindings.json ~/.config/Code/User/keybindings.json
config/vscode/code-flags.conf ~/.config/code-flags.conf

# gh: settings only — hosts.yml (account + token) stays out of the repo
config/gh/config.yml ~/.config/gh-work/config.yml
config/gh/config.yml ~/.config/gh-personal/config.yml

# CLI tools beyond the server profile
config/herdr ~/.config/herdr
config/claude ~/.config/ws/claude
config/lazygit ~/.config/lazygit
config/lazydocker ~/.config/lazydocker
config/k9s ~/.config/k9s
config/superfile ~/.config/superfile
config/terraform/terraformrc ~/.terraformrc

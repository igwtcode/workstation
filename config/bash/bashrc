if [[ -r ~/.config/shell/xdg.sh ]]; then
  # shellcheck source=config/shell/xdg.sh
  source ~/.config/shell/xdg.sh
fi
if [[ -r ~/.config/shell/telemetry.sh ]]; then
  # shellcheck source=config/shell/telemetry.sh
  source ~/.config/shell/telemetry.sh
fi

[[ $- != *i* ]] && return

export EDITOR=nvim
export VISUAL=nvim
export PATH=$PATH:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.local/bin

set -o vi

alias ..='cd ..'
alias ...='cd ../..'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias v='nvim'

command -v starship &>/dev/null && eval "$(starship init bash)"

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"vim_mode": true,
	"base_keymap": "VSCode",
	"cursor_blink": false,
	"cursor_shape": "block",
	"buffer_line_height": {
		"custom": 1.6
	},
	"relative_line_numbers": "enabled",
	"ui_font_size": 15.0,
	// SF Mono is mac-only; linux lands on the fallbacks
	"ui_font_family": "Liga SFMono Nerd Font",
	"ui_font_fallbacks": ["GeistMono Nerd Font Propo"],
	"ui_font_weight": 400,
	"ui_font_features": {
		"calt": false,
		"liga": false
	},
	"buffer_font_size": 15.0,
	"buffer_font_family": "Liga SFMono Nerd Font",
	"buffer_font_fallbacks": ["GeistMono Nerd Font Mono"],
	"buffer_font_features": {
		"calt": false,
		"liga": false
	},
	"buffer_font_weight": 400,
	"terminal": {
		"copy_on_select": true,
		"line_height": {
			"custom": 1.6
		},
		"font_family": "Liga SFMono Nerd Font",
		"font_fallbacks": ["GeistMono Nerd Font Mono"],
		"font_features": {
			"calt": false,
			"liga": false
		},
		"font_weight": 500
		// "font_size": 15,
	},
	"theme": {
		"mode": "dark",
		"light": "Tokyo Night Light",
		"dark": "Tokyo Night"
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Zed (Default)",
		"dark": "Zed (Default)"
	},
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
    "effort": "high"
   },
   "type": "registry"
		},
		"opencode": {
			"default_config_options": {
				"effort": "high",
				"model": "openai/gpt-5.5"
			},
			"type": "registry"
		}
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"inlay_hints": {
		"enabled": false
	},
	"lsp": {
		"gopls": {
			"initialization_options": {
				"gofumpt": true,
				"usePlaceholders": true,
				"staticcheck": true,
				"codelenses": {
					"gc_details": true,
					"generate": true,
					"regenerate_cgo": true,
					"tidy": true,
					"upgrade_dependency": true,
					"vendor": true
				},
				"analysis": {
					"completeUnimported": true,
					"staticcheck": true,
					"unusedParams": true,
					"unusedWrite": true
				},
				"hints": {
					"assignVariableTypes": true,
					"compositeLiteralFields": true,
					"compositeLiteralTypes": true,
					"constantValues": true,
					"functionTypeParameters": true,
					"parameterNames": true,
					"rangeVariableTypes": true
				}
			}
		}
	}
}

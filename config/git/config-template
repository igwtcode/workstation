# vim: ft=gitconfig
# git config for the active theme — rendered by `mise run theme` into
# `config` (this dir links to ~/.config/git, git's XDG config path); edit
# this template only.
#
# No [user] identity here on purpose: it comes from the identity zones —
# every repo under ~/work or ~/personal picks up that zone's generated
# .gitconfig below (written by `mise run identity` from WS_ZONES). A stray
# `git config --global` writes into the rendered file and shows up in
# `git diff` — intended.

[init]
  defaultBranch = main

# Zone identity. A gitdir pattern ending in `/` matches the directory and
# everything under it; a missing file is simply ignored, so this is safe
# before `mise run identity` has run.
[includeIf "gitdir:~/work/"]
  path = ~/work/.gitconfig

[includeIf "gitdir:~/personal/"]
  path = ~/personal/.gitconfig

[core]
  editor = nvim
  pager = delta
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  autocrlf = input

[color]
  ui = auto

[pull]
  rebase = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

[interactive]
  diffFilter = delta --color-only

[delta]
  features = colors
  navigate = true
  side-by-side = true

# Theme colors; diff plus/minus backgrounds are left to delta's own
# light/dark defaults ({{mode}} renders to `dark` or `light`).
[delta "colors"]
  {{mode}} = true
  syntax-theme = colors
  blame-palette = "{{bg}} {{bg_alt}}"
  commit-decoration-style = "box ul"
  file-style = "{{fg}}"
  file-decoration-style = "{{fg}}"
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "bold"
  hunk-header-line-number-style = "bold {{fg_dim}}"
  hunk-header-decoration-style = "box ul"
  line-numbers = true
  line-numbers-left-style = "{{fg_dim}}"
  line-numbers-right-style = "{{fg_dim}}"
  line-numbers-zero-style = "{{fg_dim}}"
  line-numbers-minus-style = "bold {{color9}}"
  line-numbers-plus-style = "bold {{color10}}"
